[Unit]
Description=alert-clock gateway (NEPTUN to the clock)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alert-gateway
WorkingDirectory=@GATEWAY_DIR@
ExecStart=@GATEWAY_DIR@/.venv/bin/python -m alert_gateway --config /etc/alert-gateway.toml
Restart=on-failure
RestartSec=10
# Exit status 2 is a configuration error: restarting cannot fix it.
RestartPreventExitStatus=2
CacheDirectory=alert-gateway

[Install]
WantedBy=multi-user.target
